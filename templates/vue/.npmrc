# Squire Vue layer: keep the release install boring.
#
# min-release-age (days): npm install and npm update skip versions published less than a day ago, so a hijacked
# release that is pulled within hours never reaches the lock file. npm reads it from 11.10 on; older npm ignores it.
# npm ci installs the lock file exactly, so the release never picks a version itself: this guards the day you write
# the lock. Need a fix published this morning? Install it on purpose, then review the lock diff:
#   npm install --min-release-age=0 some-package@1.2.3
#
# Install scripts never run on a release (SQUIRE_NPM_IGNORE_SCRIPTS=1). A package that needs its own (a native
# addon, a binary download) is named in SQUIRE_NPM_REBUILD in .env.squire, and only it runs them after the install.
min-release-age=1
#
# ignore-scripts: install scripts never run on a release or in dev installs. A package that needs its own is
# rebuilt on purpose with `npm rebuild <package>`, the same story SQUIRE_NPM_REBUILD tells for the release.
ignore-scripts=true
#
# audit: npm audits on install, so a known-bad version is seen when the lock is written.
audit=true

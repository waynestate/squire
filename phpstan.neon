# The cut comes from Pinstripe (waynestate/pinstripe), the stack's coding standard:
# level 8, ignore reporting, strict rules off for an existing app. Below stays only
# what is SQUIRE's own: the paths and the PHP version range.
includes:
    - vendor/waynestate/pinstripe/phpstan/raw.neon

parameters:
    paths:
        - src
        - bin/squire
    phpVersion:
        min: 80300
        max: 80599

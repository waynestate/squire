{
    "name": "waynestate/squire",
    "description": "The Citadel kit: standard build.sh, release script and health check, and local parity on the Citadel images.",
    "homepage": "https://squire.apps.wayne.edu/",
    "support": {
        "source": "https://github.com/waynestate/squire"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/console": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "ci": [
            "@composer validate --strict",
            "phpunit",
            "pint --test",
            "phpstan analyse --memory-limit=1G",
            "@composer audit"
        ]
    },
    "scripts-descriptions": {
        "ci": "Run every CI check: manifest, tests, style, static analysis, audit"
    },
    "bin": [
        "bin/squire"
    ],
    "autoload": {
        "psr-4": {
            "Waynestate\\Squire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Squire\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
